# Sao chép thành backend/.env rồi điền giá trị. KHÔNG commit .env
ENVIRONMENT=development
# false = dữ liệu thật Open-Meteo; true = dữ liệu mô phỏng
DEMO_MODE=false
CAMERA_ENABLED=false

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=urban_flood_dss
# Chỉ dùng cho scripts/migrate_mysql_to_postgres.py (đọc dữ liệu MySQL cũ)
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=urban_flood_dss

# Sinh bằng: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Tài khoản quản trị ban đầu. Để trống ADMIN_PASSWORD -> sinh ngẫu nhiên, in ra 1 lần khi bootstrap
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=300

# Quét định kỳ camera giao thông (TT-*) trong bán kính của điểm ngập bằng YOLOv8-seg đang dùng.
# Mặc định tắt: cần mạng tới cổng giao thông TP.HCM và một mô hình YOLOV8_SEG đang kích hoạt.
CAMERA_SCAN_ENABLED=false
CAMERA_SCAN_INTERVAL_MINUTES=15
CAMERA_SCAN_MAX_PER_RUN=20
CAMERA_SCAN_RADIUS_M=500
